# แม่แบบค่าตั้งโหมด SaaS — คัดลอกเป็น .env แล้วเปลี่ยนรหัสผ่าน

DEPLOY_PROFILE=saas

POSTGRES_DB=siem
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_PUBLISH_PORT=5433

APP_DB_PASSWORD=change-me-app
ADMIN_DB_PASSWORD=change-me-admin
EVALUATOR_DB_PASSWORD=change-me-evaluator
OWNER_DB_PASSWORD=change-me-owner

API_PORT=8080
SESSION_SECRET=change-me-to-32-plus-random-bytes
SESSION_TTL_HOURS=12
COOKIE_SECURE=true

SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514

RETENTION_DAYS=7

WEBHOOKS_ENABLED=true
WEBHOOK_TIMEOUT_MS=5000

ENRICH_ENABLED=true
ENRICH_RDNS_ENABLED=true
RDNS_TIMEOUT_MS=1500
RDNS_SERVERS=

WEB_PORT=8081
WEB_TLS_PORT=8443
TLS_CN=localhost

# ความปลอดภัย: จำนวนคำขอต่อ IP ต่อนาที และล็อกบัญชีเมื่อรหัสผิดซ้ำ (0 = ปิด)
LOGIN_RATE_LIMIT_PER_MIN=20
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15
INGEST_RATE_LIMIT_PER_MIN=1200

# GET /api/metrics: ตั้งค่านี้เพื่อให้ Prometheus ใช้ Bearer token ได้ ถ้าว่างต้องล็อกอินเป็น Admin
METRICS_TOKEN=

# รหัสผ่านบัญชีเดโมที่ seed สร้าง (ว่าง = admin123 / viewer123)
SEED_ADMIN_PASSWORD=
SEED_VIEWER_PASSWORD=
