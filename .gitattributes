# Normalise line endings in the repository regardless of the machine that
# commits. This is not cosmetic: these scripts run on the Linux VM, and a shell
# script checked out with CRLF fails with `bad interpreter: /usr/bin/env bash^M`
# — an error that says nothing about the real cause.
* text=auto eol=lf

# Never let these become CRLF, whatever the developer's core.autocrlf says.
*.sh          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.sql         text eol=lf
*.conf        text eol=lf
Dockerfile    text eol=lf
Caddyfile     text eol=lf
Makefile      text eol=lf
.env.example  text eol=lf

# Binary, so git does not try to be clever with them.
*.mmdb        binary
*.png         binary
*.jpg         binary
*.gz          binary
