# ---- Appliance profile -------------------------------------------------
# Copy to .env and edit before `docker compose up`.

DEPLOY_PROFILE=appliance

# Postgres (the container's own superuser bootstrap)
POSTGRES_DB=siem
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Host port the database is published on (0 = do not publish)
DB_PUBLISH_PORT=5433

# Least-privilege application roles created by the migration bootstrap
APP_DB_PASSWORD=change-me-app
ADMIN_DB_PASSWORD=change-me-admin
EVALUATOR_DB_PASSWORD=change-me-evaluator
OWNER_DB_PASSWORD=change-me-owner

# API
API_PORT=8080
SESSION_SECRET=change-me-to-32-plus-random-bytes
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Syslog listeners
SYSLOG_UDP_PORT=514
SYSLOG_TCP_PORT=514

# Retention, in whole days. The README specifies 7.
RETENTION_DAYS=7

# Outbound webhook delivery for alerts
WEBHOOKS_ENABLED=false
WEBHOOK_TIMEOUT_MS=5000

# Enrichment at ingest (optional). With no GeoIP database present the geo
# columns stay null and everything else is unaffected — run `make geoip` to
# download DB-IP Lite. Reverse DNS never blocks ingest: the first event from a
# new address has no hostname, later ones do.
ENRICH_ENABLED=true
ENRICH_RDNS_ENABLED=true
RDNS_TIMEOUT_MS=1500
# Nameservers for PTR lookups. Leave empty to use the host resolver; in Docker
# that cannot do reverse lookups, so set one here for the demo. On an appliance
# point it at the internal DNS that knows your workstation names.
RDNS_SERVERS=

# Frontend
WEB_PORT=8081
WEB_TLS_PORT=8443
# Common name for the self-signed certificate (SaaS: use your real hostname)
TLS_CN=localhost
